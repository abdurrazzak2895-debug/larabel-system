              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('success envelope', function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test('cities array', function () { pm.expect(body.data.cities).to.be.an('array'); });",
                  "if (body.data.cities && body.data.cities.length) {",
                  "  const first = body.data.cities[0];",
                  "  const city = typeof first === 'string' ? first : (first.name || first.city || first.value);",
                  "  if (city) pm.collectionVariables.set('city', city);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
