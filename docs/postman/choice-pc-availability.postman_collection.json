  "item": [
    {
      "name": "Takamol Gateway",
      "description": "Uses X-Takamol-API-Key and the shared server-side Takamol/T2Hub session.",
      "item": [
        {
          "name": "1. Occupations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Takamol-API-Key",
                "value": "{{takamol_api_key}}"
              }
            ],
            "url": {
              "raw": "{{api_base_url}}/api/external/takamol-availability/v1/occupations?search={{search}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "external",
                "takamol-availability",
                "v1",
                "occupations"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{search}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('success envelope', function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test('occupations array', function () { pm.expect(body.data.occupations).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Cities",
          "request": {
            "method": "GET",
            "header": [
