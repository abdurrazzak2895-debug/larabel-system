{
  "info": {
    "_postman_id": "b7bd3e56-2c0e-4c08-8d3d-4e1a5b7c9d21",
    "name": "Choice PC SVP/Takamol Availability API",
    "description": "Read-only availability API tests for the Takamol shared-session gateway and the optional candidate-session SVP gateway. Set the collection variables before sending requests. Never commit a real API key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_base_url",
      "value": "https://api.choice-pc-sv.xyz",
      "type": "string"
    },
    {
      "key": "takamol_api_key",
      "value": "",
      "type": "secret"
    },
    {
      "key": "portal_api_key",
      "value": "",
      "type": "secret"
    },
    {
      "key": "search",
      "value": "Barber",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "50",
      "type": "string"
    },
    {
      "key": "city",
      "value": "Dhaka",
