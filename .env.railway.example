# =========================================================
# SVP Takamol — Railway (Production) environment variables
# =========================================================
# Add these variables in the Railway dashboard (Variables tab)
# on the App, Worker and Cron services — or set them once at
# the Environment/Project level so every service shares them.
#
# APP_KEY must be generated locally first:
#     php artisan key:generate --show
# Then paste the resulting base64 value into the dashboard.

APP_NAME="SVP Takamol"
APP_ENV=production
APP_DEBUG=false

# Paste the output of:  php artisan key:generate --show
APP_KEY=

# Public URL — use the Railway generated domain or your custom
# domain, e.g. https://svp-takamol-production.up.railway.app
APP_URL=https://your-project-name.up.railway.app

# ---------------------------------------------------------
# PostgreSQL (Railway Postgres service)
# ---------------------------------------------------------
DB_CONNECTION=pgsql
# Option A: reference the Railway Postgres service variable:
DB_URL=${{Postgres.DATABASE_URL}}
# Option B: paste the DATABASE_URL value from the Postgres
# service "Variables" tab directly:
# DB_URL=postgresql://user:password@host:port/database

# ---------------------------------------------------------
# Sessions / Queue / Cache — all database-backed
# ---------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------
# Logging — stream logs to Railway instead of disk files
# ---------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter

# ---------------------------------------------------------
# Filesystem (uploads are stored on the ephemeral container;
# use S3/Cloud Storage if you need persisted files)
# ---------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------
# PACC / SVP external service credentials
# ---------------------------------------------------------
PACC_BASE_URL=https://api.pacc.example.com
PACC_CLIENT_ID=
PACC_CLIENT_SECRET=
PACC_AGENCY_CODE=

# ---------------------------------------------------------
# Platform admin account (used by RolesAndPermissionsSeeder)
# ---------------------------------------------------------
ADMIN_EMAIL=admin@takamol.example.com
ADMIN_PASSWORD=ChangeMe123!
