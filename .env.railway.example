# =========================================================
# SVP Takamol — Railway (Production) environment variables
# =========================================================
# Add these variables in the Railway dashboard (Variables tab)
# on the App, Worker and Cron services — or set them once at
# the Environment/Project level so every service shares them.
#
# APP_KEY must be generated locally first:
#     php artisan key:generate --show
# Then paste the resulting base64 value into the dashboard.

APP_NAME="SVP Takamol"
APP_ENV=production
APP_DEBUG=false

# Paste the output of:  php artisan key:generate --show
APP_KEY=

# Public URL — use the Railway generated domain or your custom
# domain, e.g. https://svp-takamol-production.up.railway.app
APP_URL=https://your-project-name.up.railway.app

# ---------------------------------------------------------
# PostgreSQL (Railway Postgres service)
# ---------------------------------------------------------
DB_CONNECTION=pgsql
# Option A: reference the Railway Postgres service variable:
DB_URL=${{Postgres.DATABASE_URL}}
# Option B: paste the DATABASE_URL value from the Postgres
# service "Variables" tab directly:
# DB_URL=postgresql://user:password@host:port/database

# ---------------------------------------------------------
# Sessions / Queue / Cache — all database-backed
# ---------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------
# Logging — stream logs to Railway instead of disk files
# ---------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter

# ---------------------------------------------------------
# Filesystem (uploads are stored on the ephemeral container;
# use S3/Cloud Storage if you need persisted files)
# ---------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------
# PACC / SVP external service credentials
# ---------------------------------------------------------
# The Laravel app reads the SVP_* variables below (see config/svp.php).
# The PACC_* values are kept for reference / legacy integrations only.
PACC_CLIENT_ID=
PACC_CLIENT_SECRET=
PACC_AGENCY_CODE=

# SVP / Takamol API — base URL and request behaviour. SVP_TIMEOUT and
# SVP_RETRY_TIMES keep page loads fast when the external API is slow or
# unreachable, and SVP_LOG_REQUESTS=false stops full PACC payloads from
# being written into the logs.
SVP_BASE_URL=https://svp-international-api.pacc.sa
SVP_BASE_URL_HOST=svp-international-api.pacc.sa
SVP_TENANT_NAME=svp-international
SVP_TIMEOUT=8
SVP_RETRY_TIMES=1
SVP_RETRY_DELAY=250
SVP_LOG_REQUESTS=false
SVP_LOG_CHANNEL=stderr

# Read-only portal availability adapter. Never place a session cookie here;
# enter authorized session credentials through the encrypted admin dashboard.
PORTAL_AVAILABILITY_BASE_URL=https://svp-international.xyz
PORTAL_AVAILABILITY_TIMEOUT=15
PORTAL_AVAILABILITY_CONNECT_TIMEOUT=5
PORTAL_AVAILABILITY_CACHE_TTL=30
PORTAL_AVAILABILITY_CREDENTIAL_CACHE_TTL=60
PORTAL_AVAILABILITY_DELAY_MS=250
PORTAL_AVAILABILITY_EXTERNAL_RATE_LIMIT=60

# ---------------------------------------------------------
# Platform admin account (used by RolesAndPermissionsSeeder)
# ---------------------------------------------------------
ADMIN_EMAIL=admin@takamol.example.com
ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------
# Optional integrations — set to `null` to mark them DISABLED.
# Laravel's env() casts the literal string "null" to PHP null,
# which is identical to leaving the variable unset, but setting
# them explicitly prevents Railway's Laravel config-check from
# warning on every boot ("references the X environment variable,
# but it is not set"). All services should share these:
# ---------------------------------------------------------
DYNAMODB_ENDPOINT=null
MYSQL_ATTR_SSL_CA=null
REDIS_URL=null
DB_CACHE_CONNECTION=null
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=null
CACHE_STORAGE_DISK=null
MEMCACHED_PERSISTENT_ID=null
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null
AWS_ACCESS_KEY_ID=null
AWS_SECRET_ACCESS_KEY=null
AWS_DEFAULT_REGION=null
AWS_BUCKET=null
AWS_URL=null
AWS_ENDPOINT=null
LOG_SLACK_WEBHOOK_URL=null
PAPERTRAIL_URL=null
PAPERTRAIL_PORT=null
MAIL_SCHEME=null
MAIL_URL=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
POSTMARK_MESSAGE_STREAM_ID=null
POSTMARK_API_KEY=null
MAIL_LOG_CHANNEL=null
DB_QUEUE_CONNECTION=null
SQS_SUFFIX=null
RESEND_API_KEY=null
SESSION_CONNECTION=null
SESSION_STORE=null
SESSION_DOMAIN=null
SLACK_BOT_USER_OAUTH_TOKEN=null
SLACK_BOT_USER_DEFAULT_CHANNEL=null

