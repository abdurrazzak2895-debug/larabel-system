APP_NAME="SVP Takamol"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: use MySQL/PostgreSQL, not SQLite
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=takamol
# DB_USERNAME=takamol
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3   ; production — use S3 or public disk

QUEUE_CONNECTION=database
CACHE_STORE=database

# Production: set to redis with phpredis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@takamol.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SVP/Takamol lookup scope
SVP_COUNTRY_ID=78
SVP_DEFAULT_LANGUAGE_CODE=LOABB
SVP_DEFAULT_METHODOLOGY=in_person

# Read-only portal availability adapter
PORTAL_AVAILABILITY_BASE_URL=https://svp-international.xyz
PORTAL_AVAILABILITY_TIMEOUT=15
PORTAL_AVAILABILITY_CONNECT_TIMEOUT=5
PORTAL_AVAILABILITY_CACHE_TTL=30
PORTAL_AVAILABILITY_CREDENTIAL_CACHE_TTL=60
PORTAL_AVAILABILITY_DELAY_MS=250
PORTAL_AVAILABILITY_EXTERNAL_RATE_LIMIT=60

# PACC / SVP external service credentials
PACC_BASE_URL=https://api.pacc.example.com
PACC_CLIENT_ID=
PACC_CLIENT_SECRET=
PACC_AGENCY_CODE=

# Platform admin credentials (seed)
ADMIN_EMAIL=admin@takamol.example.com
ADMIN_PASSWORD=ChangeMe123!

VITE_APP_NAME="${APP_NAME}"

# Manual portal wallet deposits (admin approval only)
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
PORTAL_MERCHANT_NAME="Portal Wallet"
